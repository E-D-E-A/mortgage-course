---
import BaseLayout from "../layouts/BaseLayout.astro";
import { checkHref, isBuilt, isCheckBuilt, lessonHref, stages } from "../lib/course.ts";
---

<BaseLayout title="מפת הקורס">
  <div class="mx-auto max-w-6xl px-4 py-10">
    <h1 class="text-h1 text-navy">קורס המשכנתאות של Mogi</h1>
    <p class="mt-3 max-w-2xl text-body-l text-n700">
      מאפס מוחלט — מה זה אחוז, מה זו ריבית — ועד האלגוריתם שבונה תמהיל. עשרה שלבים, ומומלץ ללכת לפי הסדר, כי כל שיעור נשען על מה שכבר נלמד. הכול פתוח: אפשר להיכנס לכל שלב, שיעור וסעיף בכל רגע, והדף הזה מראה לכם איפה אתם.
    </p>
    <p id="overall-progress" class="mt-3 hidden max-w-2xl rounded-md bg-n50 p-3 text-body-m text-n800" aria-live="polite"></p>
    <ol class="mt-10 grid gap-6">
      {
        stages.map((s) => (
          <li class="rounded-lg border border-n200 bg-n0 p-6 shadow-sm">
            <div class="flex flex-wrap items-baseline gap-3">
              <span class="rounded-pill bg-navy px-3 py-0.5 text-caption font-semibold text-turquoise">שלב {s.id}</span>
              <h2 class="text-h2 text-navy">{s.title}</h2>
              <span class="stage-done hidden rounded-pill bg-success-bg px-3 py-0.5 text-caption font-semibold text-n900" data-done={s.id}>הושלם</span>
            </div>
            <p class="mt-2 text-body-m text-n600">{s.goal}</p>
            <p
              class="stage-progress mt-2 hidden text-caption text-n700"
              data-stage={s.id}
              data-lessons={s.lessons.filter((l) => isBuilt(l.id)).map((l) => l.id).join(",")}
            >
            </p>
            <ol class="mt-4 grid gap-1 sm:grid-cols-2">
              {s.lessons.map((l) => (
                <li class="text-body-m">
                  {isBuilt(l.id) ? (
                    <a href={lessonHref(l.id)} class="flex gap-2 rounded-sm px-2 py-1 font-semibold text-navy hover:bg-mint/40">
                      <span class="w-10 shrink-0 text-n600">{l.id}</span>
                      <span>{l.title}</span>
                    </a>
                  ) : (
                    <span class="flex gap-2 px-2 py-1 text-n500">
                      <span class="w-10 shrink-0">{l.id}</span>
                      <span>{l.title}</span>
                    </span>
                  )}
                </li>
              ))}
            </ol>
            <p class="mt-3 text-body-m">
              {isCheckBuilt(s.id) ? (
                <a href={checkHref(s.id)} class="inline-flex gap-2 rounded-sm px-2 py-1 font-semibold text-navy hover:bg-mint/40">
                  <span aria-hidden="true">✔</span>
                  <span>בדיקת סיום שלב {s.id}</span>
                  <span class="check-score hidden font-normal text-n600" data-check={s.id}></span>
                </a>
              ) : (
                <span class="inline-flex gap-2 px-2 py-1 text-n500">
                  <span aria-hidden="true">✔</span>
                  <span>בדיקת סיום שלב {s.id}</span>
                </span>
              )}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</BaseLayout>

<script>
  // Shows this browser's progress per stage. Nothing here opens or closes anything: every link is always open.
  // A stage is "done" (הושלם) once its completion check has been answered at least once, with any score.
  import { load } from "../lib/progress.ts";

  type Check = { score?: number; total?: number; attempts?: number };
  const prefix = "mogi-course:";
  const savedKeys = (): string[] => {
    const keys: string[] = [];
    try {
      for (let i = 0; i < localStorage.length; i++) {
        const k = localStorage.key(i);
        if (k?.startsWith(prefix)) keys.push(k.slice(prefix.length));
      }
    } catch {
      /* storage unavailable: show no progress */
    }
    return keys;
  };
  const keys = savedKeys();
  const visited = new Set(keys.filter((k) => k.startsWith("lesson:")).map((k) => k.slice("lesson:".length)));
  const exerciseIds = keys.filter((k) => k.startsWith("exercise:") && !k.endsWith(":first")).map((k) => k.slice("exercise:".length));
  // An exercise id is its lesson id, or the lesson id followed by "-…" ("4.2-3").
  const inLesson = (id: string, lessons: Set<string>) => lessons.has(id) || lessons.has(id.split("-")[0]);

  let visitedTotal = 0;
  let lessonsTotal = 0;
  let checksDone = 0;
  const stageEls = document.querySelectorAll<HTMLElement>(".stage-progress");
  for (const el of stageEls) {
    const lessons = new Set((el.dataset.lessons ?? "").split(",").filter(Boolean));
    const seen = [...lessons].filter((l) => visited.has(l)).length;
    const exercises = exerciseIds.filter((id) => inLesson(id, lessons)).length;
    const check = load<Check>(`check:${el.dataset.stage}`);
    const answered = typeof check?.score === "number" && typeof check?.total === "number";
    const parts = [`שיעורים שנפתחו: ${seen} מתוך ${lessons.size}`, `תרגילים שנעשו: ${exercises}`];
    parts.push(answered ? `בדיקת הסיום: ${check!.score} מתוך ${check!.total}` : "בדיקת הסיום: עוד לא נעשתה");
    el.textContent = parts.join(" · ");
    el.classList.remove("hidden");
    visitedTotal += seen;
    lessonsTotal += lessons.size;
    if (answered) {
      checksDone++;
      document.querySelector<HTMLElement>(`[data-done="${el.dataset.stage}"]`)?.classList.remove("hidden");
      const mark = document.querySelector<HTMLElement>(`[data-check="${el.dataset.stage}"]`);
      if (mark) {
        mark.textContent = `· הציון האחרון: ${check!.score} מתוך ${check!.total}`;
        mark.classList.remove("hidden");
      }
    }
  }
  const overall = document.getElementById("overall-progress");
  if (overall && (visitedTotal > 0 || checksDone > 0 || exerciseIds.length > 0)) {
    overall.textContent = `ההתקדמות שלכם: ${visitedTotal} מתוך ${lessonsTotal} שיעורים נפתחו, ${checksDone} מתוך ${stageEls.length} בדיקות סיום נענו.`;
    overall.classList.remove("hidden");
  }
</script>
