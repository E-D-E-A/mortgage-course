---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import LinkRow from "../components/LinkRow.astro";
import { checkHref, isBuilt, isCheckBuilt, lessonHref, stages } from "../lib/course.ts";
import { pickStage } from "../lib/current-stage.ts";

// Printed into the page (and re-run after every client-side swap to this page, data-astro-rerun) so the stage
// the learner is in is open on the very first paint. pickStage is self-contained on purpose.
const pickScript = `(function(){var s="0";try{s=String((${pickStage.toString()})(localStorage,location.hash))}catch(e){}document.documentElement.setAttribute("data-cur",s)})()`;
// html[data-cur=N] opens stage N until the learner (or enhanceMap) sets data-open on it.
const openRules = stages
  .map((s) => `html[data-cur="${s.id}"] #stage-${s.id}:not([data-open]) > .stage-body{grid-template-rows:1fr;visibility:visible;transition-delay:0s}html[data-cur="${s.id}"] #stage-${s.id}:not([data-open]) .stage-chevron{transform:rotate(180deg)}`)
  .join("");
---

<BaseLayout title="מפת הקורס">
  <style is:global set:html={openRules} slot="head"></style>
  <script is:inline data-astro-rerun set:html={pickScript} slot="head"></script>
  <div class="mx-auto max-w-6xl px-4 py-10">
    <h1 class="text-h1 text-navy">קורס המשכנתאות של Mogi</h1>
    <p class="mt-3 max-w-2xl text-body-l text-n700">
      מאפס מוחלט — מה זה אחוז, מה זו ריבית — ועד האלגוריתם שבונה תמהיל. עשרה שלבים, ומומלץ ללכת לפי הסדר, כי כל שיעור נשען על מה שכבר נלמד. הכול פתוח: אפשר להיכנס לכל שלב, שיעור וסעיף בכל רגע, והדף הזה מראה לכם איפה אתם.
    </p>
    <p id="overall-progress" class="map-fill mt-3 flex min-h-[4.25rem] max-w-2xl items-center rounded-md bg-n50 p-3 text-body-m text-n800 sm:min-h-[3rem]" aria-live="polite">
      עוד לא פתחתם שיעור. כל שיעור שתפתחו יסומן כאן.
    </p>
    <ol class="mt-6 grid gap-4" data-course-map>
      {
        stages.map((s) => (
          <li id={`stage-${s.id}`} data-stage={s.id} class="stage scroll-mt-20 rounded-lg border border-n200 bg-n0 shadow-sm">
            <h2>
              <button
                type="button"
                class="stage-toggle flex min-h-16 w-full items-center gap-3 rounded-lg px-4 py-3 text-start transition-colors duration-fast ease-out hover:bg-n50 active:bg-n100"
                aria-expanded="false"
                aria-controls={`stage-body-${s.id}`}
              >
                <span class="shrink-0 rounded-pill bg-navy px-3 py-0.5 text-caption font-semibold text-turquoise">שלב {s.id}</span>
                <span class="min-w-0 flex-1">
                  <span class="block text-h3 text-navy">{s.title}</span>
                  <span
                    class="stage-progress map-fill mt-0.5 flex min-h-5 flex-wrap items-center gap-x-2 text-caption text-n600"
                    data-lessons={s.lessons.filter((l) => isBuilt(l.id)).map((l) => l.id).join(",")}
                  >
                    <span class="stage-progress-text">{s.lessons.filter((l) => isBuilt(l.id)).length} שיעורים</span>
                    <span class="stage-done hidden rounded-pill bg-success-bg px-2 py-0.5 text-caption font-semibold text-n900" data-done={s.id}>הושלם</span>
                  </span>
                </span>
                <Icon name="down" class="stage-chevron size-6 shrink-0 text-n600" />
              </button>
            </h2>
            <div id={`stage-body-${s.id}`} class="stage-body">
              <div class="stage-inner">
                <div class="px-4 pb-4">
                  <p class="text-body-m text-n600">{s.goal}</p>
                  <ol class="mt-3 grid gap-2 p-1 sm:grid-cols-2">
                    {s.lessons.map((l) => (
                      <li>
                        <LinkRow href={isBuilt(l.id) ? lessonHref(l.id) : undefined} num={l.id} title={l.title} lesson={l.id} />
                      </li>
                    ))}
                  </ol>
                  <p class="stage-exercises map-fill mt-2 min-h-5 px-1 text-caption text-n600" />
                  <div class="mt-2 p-1 sm:max-w-md">
                    <LinkRow
                      href={isCheckBuilt(s.id) ? checkHref(s.id) : undefined}
                      title={`בדיקת סיום שלב ${s.id}`}
                      check={isCheckBuilt(s.id) ? s.id : undefined}
                      note="בכתיבה"
                    />
                  </div>
                </div>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</BaseLayout>
