---
import BaseLayout from "../layouts/BaseLayout.astro";
import { isBuilt, lessonHref, stages } from "../lib/course.ts";
---

<BaseLayout title="מפת הקורס">
  <div class="mx-auto max-w-6xl px-4 py-10">
    <h1 class="text-h1 text-navy">קורס המשכנתאות של Mogi</h1>
    <p class="mt-3 max-w-2xl text-body-l text-n700">
      מאפס מוחלט — מה זה אחוז, מה זו ריבית — ועד האלגוריתם שבונה תמהיל. עשרה שלבים, לפי הסדר. כל שיעור נשען רק על מה שכבר נלמד.
    </p>
    <ol class="mt-10 grid gap-6">
      {
        stages.map((s) => (
          <li class="rounded-lg border border-n200 bg-n0 p-6 shadow-sm">
            <div class="flex flex-wrap items-baseline gap-3">
              <span class="rounded-pill bg-navy px-3 py-0.5 text-caption font-semibold text-turquoise">שלב {s.id}</span>
              <h2 class="text-h2 text-navy">{s.title}</h2>
            </div>
            <p class="mt-2 text-body-m text-n600">{s.goal}</p>
            <ol class="mt-4 grid gap-1 sm:grid-cols-2">
              {s.lessons.map((l) => (
                <li class="text-body-m">
                  {isBuilt(l.id) ? (
                    <a href={lessonHref(l.id)} class="flex gap-2 rounded-sm px-2 py-1 font-semibold text-navy hover:bg-mint/40">
                      <span class="w-10 shrink-0 text-n600">{l.id}</span>
                      <span>{l.title}</span>
                    </a>
                  ) : (
                    <span class="flex gap-2 px-2 py-1 text-n500">
                      <span class="w-10 shrink-0">{l.id}</span>
                      <span>{l.title}</span>
                    </span>
                  )}
                </li>
              ))}
            </ol>
          </li>
        ))
      }
    </ol>
  </div>
</BaseLayout>
