---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BackLink from "../../components/BackLink.astro";
import LinkRow from "../../components/LinkRow.astro";
import glossary from "../../data/glossary.json";
import { isBuilt, lessonById, lessonHref } from "../../lib/course.ts";

const written = Object.entries(glossary as Record<string, { lesson: string; definition: string | null }>)
  .filter(([, e]) => e.definition)
  .sort(([a], [b]) => a.localeCompare(b, "he"));
const total = Object.keys(glossary).length;
---

<BaseLayout title="מילון מונחים">
  <div class="mx-auto max-w-3xl px-4 py-10">
    <!-- Back to the page the learner came from (a lesson, usually); the course map when they opened the glossary directly. -->
    <BackLink href="/" label="חזרה" history />
    <h1 class="mt-1 text-h1 text-navy">מילון מונחים</h1>
    <p class="mt-3 text-body-m text-n600">
      {written.length} מתוך {total} המונחים של הקורס כבר הוגדרו. מונח נכנס למילון כשהשיעור שלו נכתב.
    </p>
    <dl class="mt-8 divide-y divide-n200 rounded-lg border border-n200 bg-n0 shadow-sm">
      {
        written.map(([term, e]) => (
          <div class="scroll-mt-20 p-5" id={term}>
            <dt class="text-h3 text-navy">{term}</dt>
            <dd class="mt-1 text-body-l text-n700">{e.definition}</dd>
            <dd class="mt-3">
              <LinkRow
                href={isBuilt(e.lesson) ? lessonHref(e.lesson) : undefined}
                num={e.lesson}
                title={lessonById(e.lesson)?.title ?? `שיעור ${e.lesson}`}
                lesson={e.lesson}
              />
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</BaseLayout>
