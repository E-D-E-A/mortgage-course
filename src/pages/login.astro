---
import PublicLayout from "../layouts/PublicLayout.astro";
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? "";
const domain = import.meta.env.PUBLIC_ALLOWED_DOMAIN ?? "first-edea.com";
---

<PublicLayout title="כניסה">
  <h1 class="mt-6 text-h2 text-navy">קורס המשכנתאות של Mogi</h1>
  <p class="mt-2 text-body-m text-n600">הקורס לצוות בלבד. נכנסים עם חשבון Google של החברה ({domain}).</p>
  <p id="error" class="mt-4 hidden rounded-md bg-danger-bg p-3 text-body-m text-n800" role="alert"></p>
  <p id="signed-out" class="mt-4 hidden rounded-md bg-info-bg p-3 text-body-m text-n800">יצאת מהקורס.</p>
  <a
    id="google"
    href="#"
    class="mt-6 inline-flex min-h-11 w-full items-center justify-center rounded-md bg-turquoise px-5 py-3 text-body-m font-semibold text-navy transition-colors duration-fast ease-out hover:bg-teal-deep hover:text-n0 active:scale-[0.98] active:bg-turquoise-hover"
  >
    כניסה עם Google של החברה
  </a>
  <script is:inline define:vars={{ supabaseUrl, domain }}>
    const params = new URLSearchParams(location.search);
    const error = document.getElementById("error");
    if (params.get("error") === "domain") {
      error.textContent = `החשבון שבחרת לא שייך ל־${domain}. צריך להיכנס עם חשבון Google של החברה.`;
      error.classList.remove("hidden");
    } else if (params.get("error")) {
      error.textContent = "הכניסה לא הצליחה. נסו שוב.";
      error.classList.remove("hidden");
    }
    if (params.get("signed_out")) document.getElementById("signed-out").classList.remove("hidden");
    const next = params.get("next") || "/";
    try { sessionStorage.setItem("mogi-course:next", next.startsWith("/") ? next : "/"); } catch {}
    const redirectTo = `${location.origin}/auth/callback/`;
    // `hd` asks Google to offer company accounts first. It is only a hint: the server checks the domain.
    document.getElementById("google").href =
      `${supabaseUrl}/auth/v1/authorize?provider=google&redirect_to=${encodeURIComponent(redirectTo)}&hd=${encodeURIComponent(domain)}&prompt=select_account`;
  </script>
</PublicLayout>
