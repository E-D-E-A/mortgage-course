---
// The few icons the course chrome needs, drawn inline so nothing is fetched. Decorative: the text beside
// each icon (or the link's aria-label) carries the meaning. Directions are for a right-to-left page:
// "forward" points left (toward where you read next), "back" points right.
interface Props {
  name: "forward" | "back" | "down" | "check" | "logout";
  class?: string;
}
const { name, class: className = "size-5" } = Astro.props;
const paths = {
  forward: "M15 6l-6 6 6 6",
  back: "M5 12h14M13 6l6 6-6 6",
  down: "M6 9l6 6 6-6",
  check: "M5 12.5l4.5 4.5L19 7.5",
  logout: "M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3M10 8l-4 4 4 4M6 12h10",
};
---

<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={paths[name]}></path></svg>
