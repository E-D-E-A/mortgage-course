---
// The lesson's short video. No narration in v1: the picture carries the key
// numbers, and Hebrew subtitles (a WebVTT track, on by default) carry the
// sentences — the script narration can be recorded from later without
// re-producing. The script under the player is read from that same subtitle
// file, so the two can never disagree.
import { readFileSync } from "node:fs";
import { join } from "node:path";

interface Props {
  lesson: string;
}
const { lesson } = Astro.props;
const base = `/video/${lesson}`;
const vtt = readFileSync(join(process.cwd(), "public", "video", `${lesson}.he.vtt`), "utf8");
const lines = vtt
  .split(/\n\n+/)
  .map((block) => block.split("\n"))
  .filter((b) => b.some((l) => l.includes("-->")))
  .map((b) => b.slice(b.findIndex((l) => l.includes("-->")) + 1).join(" "));
const seconds = Math.max(...vtt.match(/\d\d:\d\d:\d\d\.\d{3}/g)!.map((t) => t.split(":").reduce((a, x) => a * 60 + Number(x), 0)));
const minutes = Math.max(1, Math.round(seconds / 30) / 2);
---

<figure class="my-6">
  <video class="w-full rounded-lg border border-n200 bg-n0 shadow-sm" controls preload="metadata" playsinline poster={`${base}-poster.png`}>
    <source src={`${base}.mp4`} type="video/mp4" />
    <track kind="subtitles" srclang="he" label="עברית" src={`${base}.he.vtt`} default />
    הדפדפן לא מציג וידאו. התסריט המלא נמצא מתחת.
  </video>
  <figcaption class="mt-2 text-caption text-n600">סרטון, כ־{minutes} דקות. בלי קול: המספרים על המסך, וההסבר בכתוביות.</figcaption>
  <details class="mt-2 rounded-md border border-n200 bg-n0 p-3 text-body-m text-n700">
    <summary class="cursor-pointer text-n900">התסריט המלא</summary>
    <ol class="mt-2 list-decimal space-y-1 ps-6">{lines.map((l) => <li>{l}</li>)}</ol>
  </details>
</figure>
