---
// A word the learner meets before its lesson. Says where it will be explained,
// and is the only place scripts/check-terms.mjs lets a future term appear.
// `quiet`: the sentence already names the lesson (a "בשיעור הבא" line), so the
// note would repeat it; the word shows plainly and is still a marked forward reference.
interface Props {
  lesson: string;
  quiet?: boolean;
}
const { lesson, quiet = false } = Astro.props;
---

<span><slot />{!quiet && <span class="text-caption text-n500"> (נגיע לזה בשיעור {lesson})</span>}</span>
