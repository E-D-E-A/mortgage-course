---
// A lesson part with its kind shown above the heading (prediction, video, practice…).
interface Props {
  kind: string;
}
const { kind } = Astro.props;
---

<p class="!mb-0 !mt-12 flex items-center gap-2 text-caption font-semibold text-n600"><span class="inline-block h-3 w-1 rounded-pill bg-turquoise-2" aria-hidden="true"></span>{kind}</p>
<slot />
