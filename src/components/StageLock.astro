---
// A stage opens only after the previous stage's completion check is passed
// (brief, part 2). The pass is kept where StageCheck saves it (lib/progress.ts,
// key "check:<stage>"); this reads it before the page paints and, if missing,
// hides everything marked .stage-lockable and shows the way back instead.
// It is a learning order, not access control: the gate is the login.
import { checkHref, stageById } from "../lib/course.ts";

interface Props {
  stage: number;
}
const { stage } = Astro.props;
const prev = stage - 1;
const prevStage = stageById(prev);
---

{
  stage > 0 && (
    <>
      <script is:inline define:vars={{ key: `mogi-course:check:${prev}` }}>
        try {
          const saved = JSON.parse(localStorage.getItem(key) || "null");
          if (!saved || saved.passed !== true) document.documentElement.dataset.stageLocked = "";
        } catch {
          document.documentElement.dataset.stageLocked = "";
        }
      </script>
      <div class="stage-lock-panel my-8 rounded-lg border border-n200 bg-n50 p-6">
        <p class="text-h3 text-navy">השלב הזה עדיין סגור</p>
        <p class="mt-2 text-body-l text-n700">
          הוא ייפתח אחרי שתעברו את בדיקת הסיום של שלב {prev}{prevStage ? ` — ${prevStage.title}` : ""}. כל שלב נשען על מה שנלמד בשלב שלפניו.
        </p>
        <a
          href={checkHref(prev)}
          class="mt-4 inline-flex min-h-11 items-center rounded-md bg-turquoise px-5 text-body-m font-semibold text-navy transition-colors duration-fast ease-out hover:bg-teal-deep hover:text-n0"
        >
          לבדיקת הסיום של שלב {prev}
        </a>
      </div>
    </>
  )
}
