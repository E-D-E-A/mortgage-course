---
import BaseLayout from "./BaseLayout.astro";
import BackLink from "../components/BackLink.astro";
import Icon from "../components/Icon.astro";
import { checkHref, isBuilt, isCheckBuilt, lessonById, lessonHref, neighbours, stageOf } from "../lib/course.ts";

const { frontmatter, headings = [] } = Astro.props;
const { lesson, minutes } = frontmatter;
const ref = lessonById(lesson);
if (!ref) throw new Error(`lesson ${lesson} is not in course/course-map.md`);
const stage = stageOf(lesson);
const { prev, next } = neighbours(lesson);
// The last lesson of a stage leads to the stage's completion check, not past it.
const lastInStage = stage.lessons[stage.lessons.length - 1].id === lesson;
const sections = headings.filter((h: { depth: number }) => h.depth === 2);
---

<BaseLayout title={`${lesson} ${ref.title}`}>
  <div class="mx-auto grid max-w-6xl grid-cols-[minmax(0,1fr)] gap-10 px-4 py-8 lg:grid-cols-[14rem_minmax(0,1fr)]">
    <aside class="hidden lg:block" aria-label="מבנה השיעור">
      <nav class="sticky top-24 space-y-1 text-body-m">
        <p class="mb-3 text-caption text-n500">בשיעור הזה</p>
        {
          sections.map((h: { slug: string; text: string }) => (
            <a href={`#${h.slug}`} class="block rounded-sm px-2 py-1 text-n600 hover:bg-n100 hover:text-navy">
              {h.text}
            </a>
          ))
        }
      </nav>
    </aside>

    <article class="min-w-0 max-w-3xl">
      <BackLink href={`/#stage-${stage.id}`} label={`חזרה לשלב ${stage.id}: ${stage.title}`} />
      <p class="mt-1 text-caption text-n500">שלב {stage.id} · שיעור {lesson}</p>
      <h1 class="mt-1 text-h1 text-navy">{ref.title}</h1>
      <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-body-m text-n600">
        <span>כ־{minutes} דקות, כולל תרגול</span>
        {
          ref.prereqs.length > 0 && (
            <span class="flex flex-wrap items-center gap-2">
              <span>לפני השיעור הזה:</span>
              {ref.prereqs.map((p) => {
                const pr = lessonById(p);
                return isBuilt(p) ? (
                  <a
                    href={lessonHref(p)}
                    data-astro-prefetch="hover"
                    class="inline-flex min-h-11 items-center rounded-pill bg-n100 px-4 py-1 text-caption text-navy underline decoration-n300 underline-offset-4 transition-colors duration-fast ease-out hover:bg-mint/40 hover:decoration-turquoise active:bg-mint/70"
                  >
                    {p} {pr?.title}
                  </a>
                ) : (
                  <span class="rounded-pill bg-n100 px-3 py-0.5 text-caption text-n700">
                    {p} {pr?.title}
                  </span>
                );
              })}
            </span>
          )
        }
      </div>

      <div id="lesson-visit" data-lesson={lesson} hidden></div>
      <div class="prose-lesson mt-8">
        <slot />
      </div>

      <nav class="mt-16 border-t border-n200 pt-6" aria-label="שיעור קודם והבא">
        <div class="grid gap-3 sm:grid-cols-2">
          {
            prev ? (
              <a
                href={isBuilt(prev.id) ? lessonHref(prev.id) : "/"}
                data-astro-prefetch="viewport"
                class="group flex min-h-16 items-center gap-3 rounded-md border border-n200 bg-n0 px-4 py-3 text-body-m text-navy transition-[background-color,border-color,transform] duration-fast ease-out hover:border-turquoise hover:bg-mint/40 active:scale-[0.99] active:bg-mint/70"
              >
                <Icon name="back" class="size-5 shrink-0 text-n500 transition-transform duration-fast ease-out group-hover:translate-x-0.5 group-hover:text-navy" />
                <span class="min-w-0">
                  <span class="block text-caption text-n500">הקודם</span>
                  <span class="block font-semibold">
                    {prev.id} {prev.title}
                  </span>
                </span>
              </a>
            ) : (
              <span />
            )
          }
          {
            lastInStage && isCheckBuilt(stage.id) ? (
              <a
                href={checkHref(stage.id)}
                data-astro-prefetch="viewport"
                class="group flex min-h-16 items-center gap-3 rounded-md bg-turquoise px-4 py-3 text-body-m font-semibold text-navy transition-[background-color,transform] duration-fast ease-out hover:bg-teal-deep hover:text-n0 active:scale-[0.98] active:bg-turquoise-hover sm:col-start-2"
              >
                <span class="min-w-0 flex-1">
                  <span class="block text-caption">סוף השלב</span>
                  <span class="block">בדיקת הסיום של שלב {stage.id}</span>
                </span>
                <Icon name="forward" class="size-5 shrink-0 transition-transform duration-fast ease-out group-hover:-translate-x-0.5" />
              </a>
            ) : (
              next && (
                <a
                  href={isBuilt(next.id) ? lessonHref(next.id) : "/"}
                  data-astro-prefetch="viewport"
                  class="group flex min-h-16 items-center gap-3 rounded-md bg-turquoise px-4 py-3 text-body-m font-semibold text-navy transition-[background-color,transform] duration-fast ease-out hover:bg-teal-deep hover:text-n0 active:scale-[0.98] active:bg-turquoise-hover sm:col-start-2"
                >
                  <span class="min-w-0 flex-1">
                    <span class="block text-caption">השיעור הבא{isBuilt(next.id) ? "" : " (בכתיבה)"}</span>
                    <span class="block">
                      {next.id} {next.title}
                    </span>
                  </span>
                  <Icon name="forward" class="size-5 shrink-0 transition-transform duration-fast ease-out group-hover:-translate-x-0.5" />
                </a>
              )
            )
          }
        </div>
        <div class="mt-3">
          <BackLink href={`/#stage-${stage.id}`} label={`חזרה לשלב ${stage.id} במפת הקורס`} />
        </div>
      </nav>
    </article>
  </div>
</BaseLayout>

<script>
  // Opening a lesson is saved as progress (once), so the course map can show which lessons were opened, and
  // the lesson opened last is remembered so the map opens at that stage. It opens and closes nothing: every
  // lesson is open to everyone. Runs for every lesson page shown, also after a client-side navigation.
  import { load, save } from "../lib/progress.ts";
  import { onPage } from "../lib/page.ts";
  onPage(() => {
    const id = document.getElementById("lesson-visit")?.dataset.lesson;
    if (!id) return;
    if (!load(`lesson:${id}`)) save(`lesson:${id}`, { at: new Date().toISOString() });
    if (load<{ id?: string }>("last-lesson")?.id !== id) save("last-lesson", { id, at: new Date().toISOString() });
  });
</script>
