---
import { ClientRouter } from "astro:transitions";
import "../styles/main.css";
import FontPreload from "../components/FontPreload.astro";
import Icon from "../components/Icon.astro";

interface Props {
  title: string;
  description?: string;
}
const { title, description = "קורס המשכנתאות של Mogi — לצוות בלבד" } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: "/", label: "מפת הקורס", short: "מפת הקורס" },
  { href: "/glossary/", label: "מילון מונחים", short: "מילון" },
];
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <title>{title} · קורס המשכנתאות של Mogi</title>
    <link rel="icon" type="image/png" href="/brand/mogi-logo.png" />
    <FontPreload />
    <ClientRouter />
    <slot name="head" />
  </head>
  <body class="min-h-dvh">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:start-4 focus:top-4 focus:z-tooltip focus:bg-n0 focus:p-3"
      >דלג לתוכן</a
    >
    <header transition:persist="site-header" class="sticky top-0 z-sticky border-b border-n200 bg-n0">
      <div class="mx-auto flex h-16 max-w-6xl items-center gap-2 px-4 sm:gap-4">
        <a href="/" class="flex min-h-11 items-center gap-3" aria-label="דף הבית של הקורס">
          <img src="/brand/mogi-logo.png" alt="Mogi" class="h-9 w-auto" width="198" height="197" />
          <span class="hidden text-h3 text-navy sm:inline">קורס המשכנתאות</span>
        </a>
        <nav class="ms-auto flex items-center gap-1" aria-label="ניווט ראשי">
          {
            nav.map((item) => (
              <a
                href={item.href}
                data-nav
                data-astro-prefetch="hover"
                aria-current={path === item.href ? "page" : undefined}
                class="inline-flex min-h-11 items-center rounded-md px-2 text-body-m text-n600 transition-colors duration-fast ease-out hover:bg-n50 hover:text-navy active:bg-n100 aria-[current=page]:font-semibold aria-[current=page]:text-navy sm:px-3"
              >
                <span class="sm:hidden">{item.short}</span>
                <span class="hidden sm:inline">{item.label}</span>
              </a>
            ))
          }
          <span class="mx-1 hidden h-6 w-px bg-n200 lg:block" aria-hidden="true"></span>
          <span data-who class="hidden max-w-52 truncate text-caption text-n600 lg:block lg:w-52" dir="ltr"></span>
          <a
            href="/auth/logout"
            data-logout
            data-astro-reload
            data-astro-prefetch="false"
            aria-label="יציאה"
            class="inline-flex min-h-11 min-w-11 items-center justify-center gap-2 rounded-md px-2 text-body-m text-n600 transition-colors duration-fast ease-out hover:bg-n50 hover:text-navy active:bg-n100 aria-busy:opacity-60 sm:px-3"
          >
            <Icon name="logout" class="size-5 shrink-0" />
            <span class="hidden sm:inline">יציאה</span>
          </a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="mt-16 border-t border-n200 bg-n0">
      <div class="mx-auto max-w-6xl space-y-2 px-4 py-6 text-caption text-n500">
        <p>קורס פנימי של Mogi, לצוות בלבד. הקורס אינו רישיון ואינו הסמכה. כל התיקים בקורס סינתטיים.</p>
        <p data-who-row class="invisible flex min-h-6 flex-wrap items-center gap-x-2 text-n600">
          <span>מחוברים כ־<bdi data-who dir="ltr"></bdi></span>
          <span aria-hidden="true">·</span>
          <a href="/auth/logout" data-logout data-astro-reload data-astro-prefetch="false" class="inline-flex min-h-11 items-center font-semibold text-navy underline decoration-n300 underline-offset-4 hover:decoration-turquoise">יציאה</a>
        </p>
      </div>
    </footer>
    <script>
      import "../lib/site-client.ts";
    </script>
  </body>
</html>
