---
import "../styles/main.css";

interface Props {
  title: string;
  description?: string;
}
const { title, description = "קורס המשכנתאות של Mogi — לצוות בלבד" } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: "/", label: "מפת הקורס" },
  { href: "/glossary/", label: "מילון מונחים" },
];
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <title>{title} · קורס המשכנתאות של Mogi</title>
    <link rel="icon" type="image/png" href="/brand/mogi-logo.png" />
  </head>
  <body class="min-h-dvh">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:start-4 focus:top-4 focus:z-tooltip focus:bg-n0 focus:p-3"
      >דלג לתוכן</a
    >
    <header class="sticky top-0 z-sticky border-b border-n200 bg-n0">
      <div class="mx-auto flex h-16 max-w-6xl items-center gap-4 px-4">
        <a href="/" class="flex items-center gap-3" aria-label="דף הבית של הקורס">
          <img src="/brand/mogi-logo.png" alt="Mogi" class="h-9 w-auto" width="198" height="197" />
          <span class="hidden text-h3 text-navy sm:inline">קורס המשכנתאות</span>
        </a>
        <nav class="ms-auto flex items-center gap-1" aria-label="ניווט ראשי">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class:list={[
                  "rounded-md px-3 py-2 text-body-m transition-colors duration-fast ease-out",
                  path === item.href ? "font-semibold text-navy" : "text-n600 hover:bg-n50 hover:text-navy",
                ]}
                aria-current={path === item.href ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="mt-16 border-t border-n200 bg-n0">
      <div class="mx-auto max-w-6xl px-4 py-6 text-caption text-n500">
        קורס פנימי של Mogi, לצוות בלבד. הקורס אינו רישיון ואינו הסמכה. כל התיקים בקורס סינתטיים.
      </div>
    </footer>
  </body>
</html>
