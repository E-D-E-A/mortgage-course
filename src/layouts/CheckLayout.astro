---
// The page of a stage's completion check (src/pages/checks/<stage>.mdx).
import BaseLayout from "./BaseLayout.astro";
import BackLink from "../components/BackLink.astro";
import Icon from "../components/Icon.astro";
import { isBuilt, lessonHref, stageById } from "../lib/course.ts";

const { frontmatter } = Astro.props;
const stage = stageById(Number(frontmatter.stage));
if (!stage) throw new Error(`stage ${frontmatter.stage} is not in course/course-map.md`);
const lastLesson = stage.lessons[stage.lessons.length - 1];
const nextStage = stageById(stage.id + 1);
const nextFirst = nextStage?.lessons[0];
---

<BaseLayout title={`בדיקת סיום שלב ${stage.id}`}>
  <div class="mx-auto max-w-3xl px-4 py-8">
    <BackLink href={`/#stage-${stage.id}`} label={`חזרה לשלב ${stage.id}: ${stage.title}`} />
    <p class="mt-1 text-caption text-n500">שלב {stage.id} · בדיקת סיום</p>
    <h1 class="mt-1 text-h1 text-navy">בדיקת סיום — שלב {stage.id}: {stage.title}</h1>
    <p class="mt-3 text-body-l text-n700">{stage.goal}</p>
    <div class="prose-lesson mt-8">
      <slot />
    </div>

    <nav class="mt-16 border-t border-n200 pt-6" aria-label="אחרי הבדיקה">
      <div class="grid gap-3 sm:grid-cols-2">
        {
          isBuilt(lastLesson.id) && (
            <a
              href={lessonHref(lastLesson.id)}
              data-astro-prefetch="viewport"
              class="group flex min-h-16 items-center gap-3 rounded-md border border-n200 bg-n0 px-4 py-3 text-body-m text-navy transition-[background-color,border-color,transform] duration-fast ease-out hover:border-turquoise hover:bg-mint/40 active:scale-[0.99] active:bg-mint/70"
            >
              <Icon name="back" class="size-5 shrink-0 text-n500 transition-transform duration-fast ease-out group-hover:translate-x-0.5 group-hover:text-navy" />
              <span class="min-w-0">
                <span class="block text-caption text-n500">השיעור האחרון בשלב</span>
                <span class="block font-semibold">
                  {lastLesson.id} {lastLesson.title}
                </span>
              </span>
            </a>
          )
        }
        {
          nextStage && nextFirst && isBuilt(nextFirst.id) && (
            <a
              href={lessonHref(nextFirst.id)}
              data-astro-prefetch="viewport"
              class="group flex min-h-16 items-center gap-3 rounded-md bg-turquoise px-4 py-3 text-body-m font-semibold text-navy transition-[background-color,transform] duration-fast ease-out hover:bg-teal-deep hover:text-n0 active:scale-[0.98] active:bg-turquoise-hover sm:col-start-2"
            >
              <span class="min-w-0 flex-1">
                <span class="block text-caption">השלב הבא — שלב {nextStage.id}: {nextStage.title}</span>
                <span class="block">
                  {nextFirst.id} {nextFirst.title}
                </span>
              </span>
              <Icon name="forward" class="size-5 shrink-0 transition-transform duration-fast ease-out group-hover:-translate-x-0.5" />
            </a>
          )
        }
      </div>
      <div class="mt-3">
        <BackLink href={`/#stage-${stage.id}`} label={`חזרה לשלב ${stage.id} במפת הקורס`} />
      </div>
    </nav>
  </div>
</BaseLayout>
